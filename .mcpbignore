# Python build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/

# Virtual environments (REQUIRED exclusion for uv type)
.venv/
venv/
env/
server/lib/
server/venv/

# Python/UV files. The server runs from PEP 723 inline metadata with
# `uv run --no-project`; pyproject.toml exists for `uvx --from git+...` installs
# and must not enter the bundle.
.python-version
pyproject.toml
uv.lock

# OS files
.DS_Store
Thumbs.db
._.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Git
.git/
.gitignore
.gitattributes

# CI workflows (repo tooling, not part of the server bundle)
.github/

# Testing/CI
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Plugin-specific (keep plugin working in parallel)
.claude-plugin/
CLAUDE.md

# Skills (not part of MCPB spec - desktop app won't load them)
skills/

# Dev/Release scripts (build tooling, not needed at runtime)
scripts/
release.sh
AGENTS.md

# Source image (icon.png is included)
agent-fecfile.jpeg
